APP_NAME="He Clinic Admin"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://heclinic.cyberoket.cloud

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=heclinic
DB_USERNAME=heclinic
DB_PASSWORD=

PLATO_API_TOKEN=
PLATO_BASE_URL=https://clinic.platomedical.com/api/hemedclinic
PLATO_TIMEOUT=30
PLATO_CACHE_ENABLED=true
PLATO_CACHE_TTL_FACILITY=300
PLATO_CACHE_TTL_DOCTOR=300
PLATO_CACHE_TTL_SLOTS=60
PLATO_CACHE_TTL_DEFAULT=120
PLATO_LOG_REQUESTS=true
PLATO_PROXY_RATE_LIMIT=60

ADMIN_EMAIL=admin@heclinic.com
ADMIN_PASSWORD=

SESSION_DRIVER=database
SANCTUM_STATEFUL_DOMAINS=heclinic.cyberoket.cloud

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@heclinic.com
MAIL_FROM_NAME="He Clinic"

# Resend — email OTP provider (https://resend.com)
RESEND_API_KEY=

# OTP channel: email (default) | whatsapp (requires ONESENDER_URL + ONESENDER_KEY)
OTP_CHANNEL=email

# OneSender — WhatsApp OTP provider (https://onesender.net)
ONESENDER_URL=
ONESENDER_KEY=

FIREBASE_PROJECT_ID=heclinicapps-8be27
FIREBASE_WEB_API_KEY=
FIREBASE_FIRESTORE_URL=https://firestore.googleapis.com/v1

# Optional for push notifications. Absolute path to the Firebase service
# account JSON (Firebase Console → Project Settings → Service accounts →
# Generate new private key). Keep it outside the web root, chmod 600, and never
# commit it.
#
# Alternatively you can paste the service account JSON directly in the admin
# panel: Admin → System Settings → Firebase → Service Account JSON. That value
# is stored encrypted in the DB and survives deploys, so the file path is only
# needed when you prefer to keep the key off the database.
#
# Without one of the two, push notifications will NOT be delivered.
# Verify with: php artisan push:diagnose
FIREBASE_SERVICE_ACCOUNT_PATH=

# How long signed patient-document links stay valid (minutes).
DOCUMENT_LINK_TTL_MINUTES=60
DOCUMENT_EMAIL_LINK_TTL_MINUTES=10080

# ---------------------------------------------------------------------------
# Social sign-in (POST /api/v2/auth/social-login)
# ---------------------------------------------------------------------------
# Expected `aud` claim on provider identity tokens. A token minted for a
# different app is rejected. Comma-separated.
#
# APPLE_CLIENT_IDS: the iOS bundle identifier (add the Services ID too if a web
# Apple flow is ever enabled). Defaults to com.hemedgroup.heclinicapps.
APPLE_CLIENT_IDS=com.hemedgroup.heclinicapps

# GOOGLE_CLIENT_IDS: the OAuth 2.0 client IDs from Google Cloud Console
# (APIs & Services -> Credentials) for the iOS and Android clients.
# LEAVING THIS EMPTY DISABLES THE GOOGLE AUDIENCE CHECK, which means a Google
# id_token issued to ANY other app would be accepted. Set it before go-live.
GOOGLE_CLIENT_IDS=
